# Server-side only (NOT NEXT_PUBLIC_): consumed by next.config.ts at BUILD time
# to resolve the /api/v1/* proxy rewrite. Never shipped to the browser.
# Local dev (uvicorn):        BACKEND_URL=http://localhost:8000
# Docker Compose:             BACKEND_URL=http://backend:8000
# Vercel (set in dashboard):  BACKEND_URL=https://<your-render-app>.onrender.com
BACKEND_URL=http://localhost:8000
