# ============================================================================
# CSP — environment template. Copy to .env and fill in. NO REAL SECRETS HERE.
# .env is git-ignored; only this .env.example is committed.
# ============================================================================

# --- Database (Postgres) ---
# Local uvicorn -> host is localhost. Inside Docker Compose -> host is the
# service name `postgres`. Pick the line matching how you run the backend.
DATABASE_URL=postgresql+psycopg2://csp:csp@localhost:5432/csp
# DATABASE_URL=postgresql+psycopg2://csp:csp@postgres:5432/csp   # <- inside compose

# --- Redis ---
# Same host rule as above: localhost for local uvicorn, `redis` inside compose.
REDIS_URL=redis://localhost:6379/0
# REDIS_URL=redis://redis:6379/0                                 # <- inside compose

# --- Auth / JWT ---
JWT_SECRET=change-me-32-bytes-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
# Reuse of a refresh token revoked <10s ago = two tabs refreshing at once (benign);
# older reuse = theft -> whole token family revoked.
REFRESH_REUSE_GRACE_SECONDS=10
# Login rate limit (10/min per client IP, via X-Forwarded-For). Set false in tests.
RATE_LIMIT_ENABLED=true

# --- Cookie / CORS ---
# CORS_ORIGINS is comma-separated (no JSON). Not load-bearing behind the proxy;
# only lets Render /docs be opened directly.
CORS_ORIGINS=http://localhost:3000
# false for local http://localhost (Safari rejects Secure cookies over http).
# MUST be true in production (https).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- LLM providers (Groq primary, Cerebras failover) ---
# All OPTIONAL. The app boots and runs without keys; insights are then stored
# as status=failed ("no LLM provider configured"). Set at least one to get AI.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
LLM_PROVIDER_ORDER=groq,cerebras
LLM_TIMEOUT_SECONDS=15        # per HTTP call
LLM_TOTAL_BUDGET_SECONDS=35   # overall per insight (all providers + repair calls)
AI_ENABLED=true

# --- Runtime ---
ENV=dev

# ============================================================================
# FRONTEND (Next.js) — server-side only
# ============================================================================
# BACKEND_URL is used by the next.config.js proxy rewrite (server-to-server).
# It is NOT prefixed NEXT_PUBLIC_ on purpose: the Render URL must never ship to
# the browser. The frontend has no public API-URL var — axios uses a relative
# baseURL '/api/v1'. Inside compose this becomes http://backend:8000.
BACKEND_URL=http://localhost:8000

# --- Tests (optional) ---
# pytest migrates + uses this DB (created automatically if the role can CREATE DATABASE).
# TEST_DATABASE_URL=postgresql+psycopg2://csp:csp@localhost:5432/csp_test
